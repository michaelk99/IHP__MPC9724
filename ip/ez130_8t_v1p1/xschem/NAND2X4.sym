v {xschem version=3.4.4 file_version=1.2
* SPDX-FileCopyrightText: 2026 Harald Pretl, Johannes Kepler University
* SPDX-License-Identifier: Apache-2.0 WITH SHL-2.1
* Description: xschem symbol for the EZ130 8T cell NAND2X4
*
* Derived from the PDK stdcell symbol of the cell this one replaces. EZ130
* subcircuits carry SIX ports, A [B] VDD VNW VPW VSS Y: unlike the PDK
* library they expose both well terminals, so the template ties VNW to VDD
* and VPW to VSS, which is how the layout ties them.
}
G {}
K {type=primitive
function2="0 1 & ~"
format="@name @@A @@B @VDD @VNW @VPW @VSS @@Y NAND2X4"
template="name=x1 VDD=VDD VSS=VSS VNW=VDD VPW=VSS "
extra="VDD VSS VNW VPW"
highlight=true
}
V {}
S {}
E {}
L 4 -60 -20 -30 -20 {}
L 4 -60 20 -30 20 {}
L 4 -30 -30 -30 30 {}
L 4 -30 30 5 30 {}
L 4 -30 -30 5 -30 {}
L 4 45 0 60 0 {}
B 5 -62.5 -22.5 -57.5 -17.5 {name=A dir=in goto=2 propag=2 }
B 5 -62.5 17.5 -57.5 22.5 {name=B dir=in goto=2 propag=2 }
B 5 57.5 -2.5 62.5 2.5 {name=Y dir=out }
A 4 5 0 30 270 180 {}
A 4 40 0 5 0 360 {}
T {@name} -28.75 -5 0 0 0.2 0.2 {}
T {@symname} -25 -45 0 0 0.2 0.2 {}
T {A} -55 -34 0 0 0.2 0.2 {}
T {B} -55 6 0 0 0.2 0.2 {}
T {Y} 55 -14 0 1 0.2 0.2 {}

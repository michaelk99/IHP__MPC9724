************************************************************************
* auCdl Netlist:
* 
* Library Name:  ez130_8t
************************************************************************

*.BIPOLAR
*.RESI = 2000 
*.RESVAL
*.CAPVAL
*.DIOPERI
*.DIOAREA
*.EQUATION
*.SCALE METER
*.MEGA
.PARAM



************************************************************************
* Library Name: ez130_8t
* Cell Name:    WELLTAP
* View Name:    schematic
************************************************************************

.SUBCKT WELLTAP VDD VNW VPW VSS
*.PININFO VDD:B VNW:B VPW:B VSS:B
*.CONNECT VPW VSS
*.CONNECT VNW VDD
.ENDS


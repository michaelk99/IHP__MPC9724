#
# One program per setting of the master's DIP switches, sw[3:0], read at reset.
# seqasm.py assembles this into the sequencer ROM.
#
#   reset           pulse the DUT reset line
#   loopback 0|1    mosi to miso inside the master, ss held high
#   write REG DATA  one SPI transaction, the old value comes back
#   read REG        one SPI transaction with the read flag
#   waitc N         wait for N adc_conv edges
#   stream          start the bitstream window at bit 0
#   capture N       on each of the next N adc_conv edges read HIGH then LOW, 0 is forever
#   include FILE    paste FILE here
#   halt

program 0 loopback
    # Master alone. Every word must come back as sent.
    loopback 1
    write AUX_CTRL_0 0x0000
    write AUX_CTRL_0 0xFFFF
    write AUX_CTRL_0 0xA5A5
    write AUX_CTRL_0 0x5A5A
    write AUX_CTRL_0 0x0001
    write AUX_CTRL_0 0x8000
    write AUX_CTRL_0 0x1234
    write AUX_CTRL_0 0xFEDC
    loopback 0
    halt

program 1 registers
    # Reset values, every writable register inverted, read back and restored,
    # then the startup sequence. o_tst_ctrl[6:0] is on the DUT's LEDs.
    reset
    read BIAS_CFG_0
    read BIAS_CFG_1
    read BIAS_CFG_2
    read BLOCK_CTRL_0
    read BLOCK_CTRL_1
    read TRIM_CFG_0
    read CLK_CFG_0
    read TEST_CTRL_0
    read UWB_TX_CFG_0
    read UWB_TX_CFG_1
    read AUX_CTRL_0
    write BIAS_CFG_0 0x6F15
    read BIAS_CFG_0
    write BIAS_CFG_0 0x90EA
    write BIAS_CFG_1 0x2FD3
    read BIAS_CFG_1
    write BIAS_CFG_1 0xD02C
    write BIAS_CFG_2 0xFFFC
    read BIAS_CFG_2
    write BIAS_CFG_2 0x0003
    write BLOCK_CTRL_0 0x3000
    read BLOCK_CTRL_0
    write BLOCK_CTRL_0 0xCFFF
    write BLOCK_CTRL_1 0xFF00
    read BLOCK_CTRL_1
    write BLOCK_CTRL_1 0x00FF
    write TRIM_CFG_0 0x7F1F
    read TRIM_CFG_0
    write TRIM_CFG_0 0x80E0
    write CLK_CFG_0 0x8778
    read CLK_CFG_0
    write CLK_CFG_0 0x7887
    write UWB_TX_CFG_0 0xCF5B
    read UWB_TX_CFG_0
    write UWB_TX_CFG_0 0x30A4
    write UWB_TX_CFG_1 0xCA00
    read UWB_TX_CFG_1
    write UWB_TX_CFG_1 0x35FF
    write AUX_CTRL_0 0x00FF
    read AUX_CTRL_0
    write AUX_CTRL_0 0xFF00
    # 14 only: 13 is TEST_CTRL_1, which the FPGA harness acts on, and 15 is CHIP_ID, read only
    write 14 0xBEEF
    read 14
    write 14 0x0000
    # TEST_CTRL_0 gets targeted values, never the inverse of its reset. 0x0545 is the
    # core mux off page, 0x052A the buffer page, together all of o_tst_ctrl[6:0] on the LEDs.
    write TEST_CTRL_0 0x0545
    read TEST_CTRL_0
    write TEST_CTRL_0 0x052A
    read TEST_CTRL_0
    write TEST_CTRL_0 0x0500
    include startup.seq
    halt

program 2 step_plus
    # Reset leaves the digital path where startup.seq ends, so these skip it.
    reset
    write TEST_CTRL_0 0x0D00    # arm: stimulus on, step +
    waitc 20                    # the output settles to zero on the idle
    write TEST_CTRL_0 0x1D00    # fire at the next conversion
    capture 48
    write TEST_CTRL_0 0x0500
    halt

program 3 impulse
    reset
    write TEST_CTRL_0 0x2D00
    waitc 20
    write TEST_CTRL_0 0x3D00
    capture 48
    write TEST_CTRL_0 0x0500
    halt

program 4 half_scale
    reset
    write TEST_CTRL_0 0x4D00
    waitc 20
    write TEST_CTRL_0 0x5D00
    capture 48
    write TEST_CTRL_0 0x0500
    halt

program 5 step_minus
    reset
    write TEST_CTRL_0 0x6D00
    waitc 20
    write TEST_CTRL_0 0x7D00
    capture 48
    write TEST_CTRL_0 0x0500
    halt

program 6 prbs23
    reset
    write TEST_CTRL_0 0xCD00
    waitc 20
    write TEST_CTRL_0 0xDD00
    capture 48
    write TEST_CTRL_0 0x0500
    halt

program 7 bitstream
    # The window from BRAM into data_in, clocked by the master's clk_fs.
    reset
    stream
    include startup.seq
    waitc 60                    # the filter holds only the window from here on
    capture 0
